# Environment
.venv/
config/
.env

# FastF1 disk cache (large, regenerable)
cache/

# static/plots/*.png and *_meta.json are intentionally NOT ignored: the
# weekly GitHub Actions sync commits them, and build_site.py turns them
# (plus templates/) into the static site GitHub Pages deploys.

# Generated by build_site.py — rebuilt fresh on every deploy, never
# committed (same reasoning as any other build output directory).
dist/
pages_test_root/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editor
.vscode/*
!.vscode/settings.json
