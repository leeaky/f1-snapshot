# Environment
.venv/
config/
.env

# FastF1 disk cache (large, regenerable)
cache/

# static/plots/*.png and *_meta.json are intentionally NOT ignored: the
# weekly GitHub Actions sync commits them so Render serves pre-rendered
# races as static files instead of doing a live FastF1 load per request.

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editor
.vscode/*
!.vscode/settings.json
